<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnDetailsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtDetailsType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incident"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetailsRoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="M8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="16dp"/>

        <TextView
            android:id="@+id/txtDetailsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:paddingTop="20dp"/>

        <TextView
            android:id="@+id/txtDetailsImpact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Impact"
            android:paddingTop="20dp"/>

        <TextView
            android:id="@+id/txtDetailsStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start"
            android:paddingTop="20dp"/>

        <TextView
            android:id="@+id/txtDetailsEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End"
            android:paddingTop="12dp"/>

        <TextView
            android:id="@+id/txtDetailsLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:paddingTop="20dp"/>

    </LinearLayout>

</ScrollView>