<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnSearchBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Search by Road"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editSearchRoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="e.g. M8"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:id="@+id/txtSearchCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter a road to search"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSelectedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 selected" />

        <Button
            android:id="@+id/btnSelectAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select All" />

        <Button
            android:id="@+id/btnClearSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Selection" />

        <Button
            android:id="@+id/btnSaveForMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Selected on Map" />

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#DDDDDD" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSearch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="16dp" />

</LinearLayout>